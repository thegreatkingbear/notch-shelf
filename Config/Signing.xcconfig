// Code signing team for builds from Xcode or xcodebuild.
//
// Put your own team in Config/Signing.local.xcconfig, which git ignores:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// Find the team ID in Xcode → Settings → Apple Accounts, or at
// developer.apple.com/account under Membership details.
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
