    "Drag items from the center to either side. Items on the same side appear in order, switching every %lld seconds.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데에서 양쪽으로 끌어 놓으세요. 같은 쪽에 여러 개를 놓으면 위에서부터 %lld초씩 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央から左右にドラッグしてください。同じ側に置いた項目は上から順に%lld秒ごとに切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中间拖到任意一侧。同一侧的项目按顺序每 %lld 秒轮换一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從中間拖到任一側。同一側的項目會依序每 %lld 秒輪替一次。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les éléments du centre vers un côté. Sur chaque côté, ils défilent dans l’ordre toutes les %lld secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Einträge aus der Mitte auf eine Seite. Pro Seite wechseln sie alle %lld Sekunden der Reihe nach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите элементы из центра влево или вправо. На каждой стороне они сменяются по порядку каждые %lld секунд."
          }
        }
      }
    },
