    "Access to Reminders is restricted on this Mac.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 미리 알림 접근이 제한되어 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではリマインダーへのアクセスが制限されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上对提醒事项的访问受限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 對提醒事項的取用受到限制。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux rappels est restreint sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Erinnerungen ist auf diesem Mac eingeschränkt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac доступ к Напоминаниям ограничен."
          }
        }
      }
    },
