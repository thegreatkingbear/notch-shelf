    "Allow Notch Shelf in System Settings → General → Login Items.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목에서 Notch Shelf를 허용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目で Notch Shelf を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”→“通用”→“登录项”中允许 Notch Shelf。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」→「一般」→「登入項目」中允許 Notch Shelf。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Notch Shelf dans Réglages Système → Général → Ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Notch Shelf in Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Notch Shelf в разделе «Системные настройки» → «Основные» → «Объекты входа»."
          }
        }
      }
    },
