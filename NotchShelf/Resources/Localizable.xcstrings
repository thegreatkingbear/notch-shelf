    "Choose a default list in Reminders.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림 앱에서 기본 목록을 선택하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーでデフォルトリストを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在提醒事项中选择默认列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在提醒事項中選擇預設列表。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une liste par défaut dans Rappels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in Erinnerungen eine Standardliste aus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите список по умолчанию в Напоминаниях."
          }
        }
      }
    },
    "Choose a writable default list in Reminders.": {
      "localizations": {
        "ko": {
          "stringUnit": {
