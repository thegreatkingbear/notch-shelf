    "See recent notes and jot down new ones without leaving what you’re doing.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하던 일을 멈추지 않고 최근 메모를 보고 새 메모를 남길 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業を中断せずに最近のメモを見たり、新しいメモを書き留めたりできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需中断手头工作即可查看最近的备忘录并记下新内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需中斷手邊工作即可檢視最近的備忘錄並記下新內容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez vos notes récentes et notez-en de nouvelles sans interrompre ce que vous faites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir aktuelle Notizen an und notiere neue, ohne deine Arbeit zu unterbrechen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте недавние заметки и записывайте новые, не отрываясь от дел."
          }
        }
      }
    },
