{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에서 현재 곡의 제목, 앨범 커버와 재생 시간을 표시하고 재생을 제어하며, 메모 앱의 메모를 읽고 추가합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the current track, artwork and playback time in the notch and control playback, and read and add notes in Notes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに曲名、アートワーク、再生時間を表示して再生を操作し、メモの読み取りと追加を行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海中显示当前曲目、封面和播放时间，控制播放，并读取和添加备忘录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海中顯示目前曲目、封面和播放時間，控制播放，並讀取和加入備忘錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le morceau, sa pochette et sa position de lecture dans l’encoche, contrôler la lecture, et lire et ajouter des notes dans Notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, Cover und Wiedergabezeit in der Notch anzeigen, die Wiedergabe steuern sowie Notizen in Notizen lesen und hinzufügen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать трек, обложку и время воспроизведения в вырезе, управлять воспроизведением, а также читать и добавлять заметки в Заметках."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에서 다가오는 일정을 표시하기 위해 캘린더를 읽습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your calendar to show events for the selected day in the notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日の予定をノッチに表示するため、カレンダーを読み取ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取日历，以便在刘海中显示所选日期的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取行事曆，以便在瀏海中顯示所選日期的行程。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire votre calendrier pour afficher les événements du jour sélectionné dans l’encoche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest deinen Kalender, um Termine des gewählten Tages in der Notch anzuzeigen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать календарь для отображения в вырезе событий выбранного дня."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에서 미리 알림을 보고 추가하거나 완료합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View, add and complete reminders in the notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチでリマインダーを表示、追加、完了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海中查看、添加和完成提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海中檢視、新增和完成提醒事項。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher, ajouter et terminer des rappels dans l’encoche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen in der Notch anzeigen, hinzufügen und als erledigt markieren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривать, добавлять и отмечать напоминания как выполненные прямо в вырезе."
          }
        }
      }
    }
  },
  "version": "1.0"
}
